# These two casks work on linuxbrew: they declare no depends_on and ship a
# linux-x64 `binary` artifact rather than a macOS .app bundle. Prefer them over
# the npm packages, which would pull in a global node - and which brew installs
# with scripts disabled, leaving @anthropic-ai/claude-code without the native
# binary its postinstall fetches.
# Command-line interface for 1Password
cask "1password-cli"
# The `@latest` cask tracks the release channel of the same name; the plain
# `claude-code` cask follows `stable`, which lags behind.
# Terminal-based AI coding assistant
cask "claude-code@latest"
# OpenAI's coding agent that runs in your terminal
cask "codex"
# Small, stateless webhook-to-notification relay
cask "home-operations/tap/chaski", trusted: true
# Render and diff Flux GitOps repositories offline, without a cluster
cask "home-operations/tap/flate"
# Kubectl plugin operating the kopiur Kopia-native backup operator. The cask
# links it as `kopiur`, not `kubectl-kopiur`, so it runs standalone and `kubectl
# kopiur` will not find it - it is not a drop-in for krew's kopiur/kopiur.
cask "home-operations/tap/kopiur", trusted: true
#
# All from krew's default index. The macos brewfile also carries kopiur/kopiur
# and netshoot/netshoot, which live in custom indexes: brew bundle only shells
# out to `kubectl-krew install`, so those need `kubectl krew index add <name>
# <url>` first and are omitted here rather than fail every bootstrap.
