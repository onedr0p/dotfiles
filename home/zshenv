export KUBE_EDITOR=nano
export VISUAL=nano
export EDITOR=nano
export GOPATH="$HOME/.go"
export ANSIBLE_FORCE_COLOR=true
export ANSIBLE_HOST_KEY_CHECKING=False
export PY_COLORS=true
export LANG=en_US.utf-8
export CURL_HOME="$HOME/.config/curl"

typeset -U path
# mise shims first: mise activate only fixes up PATH at the first prompt, so
# rc-time and non-interactive lookups need the shims.
for dir in \
    "$HOME/.local/share/mise/shims" \
    "$HOME/.local/bin" \
    "$HOME/.cargo/bin" \
    "$HOME/.krew/bin" \
    "$HOME/.go/bin"
do
    [[ -d $dir ]] && path=($dir $path)
done
export PATH
